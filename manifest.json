{
  "manifest_version": 3,
  "name": "Focus Lock — Website Time Box",
  "version": "1.0.0",
  "description": "Put distracting websites in a time box. Lock YouTube, Reddit & more for a set timer — like a phone safe, but for Chrome.",
  "permissions": ["storage", "tabs", "webNavigation", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Lock"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
